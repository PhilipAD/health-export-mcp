{
  "name": "health-export-mcp",
  "mcpName": "io.github.PhilipAD/health-export-mcp",
  "version": "1.7.3",
  "type": "module",
  "description": "MCP server for your own Apple Health data: 194 metrics, 16 read-only tools, 22 prompts. Zero dependencies, local stdio, no account. Try it: npx -y health-export-mcp --demo",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "apple-health",
    "healthkit",
    "apple-health-export",
    "apple-watch",
    "health-data",
    "hrv",
    "heart-rate-variability",
    "resting-heart-rate",
    "sleep",
    "vo2max",
    "workouts",
    "steps",
    "quantified-self",
    "self-tracking",
    "wearables",
    "local-first",
    "read-only",
    "privacy",
    "zero-dependency",
    "stdio",
    "mcpb",
    "claude",
    "claude-desktop",
    "claude-code",
    "cursor",
    "metricbridge"
  ],
  "homepage": "https://www.healthexport.dev/mcp/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PhilipAD/health-export-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/PhilipAD/health-export-mcp/issues"
  },
  "bin": {
    "health-export-mcp": "server.mjs"
  },
  "files": [
    "server.mjs",
    "healthstore.mjs",
    "receiver.mjs",
    "events.mjs",
    "envelope.mjs",
    "normalize.mjs",
    "metric-catalog.mjs",
    "prompts.mjs",
    "demo.mjs",
    "apply-mcp-config.mjs",
    "gen-deeplinks.mjs",
    "manifest.json",
    "server.json",
    "glama.json",
    ".mcp.json",
    "health-export.mcpb",
    "minisign.pub",
    "llms.txt",
    "AGENTS.md",
    "Dockerfile",
    ".dockerignore",
    "test/integration.mjs"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test && node test/integration.mjs",
    "test:integration": "node test/integration.mjs",
    "check:package": "node scripts/check-package-contents.mjs",
    "prepublishOnly": "node scripts/check-package-contents.mjs"
  },
  "author": "MetricBridge",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  }
}
